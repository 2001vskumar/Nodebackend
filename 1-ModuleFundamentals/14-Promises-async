// ==========================================================
// 4. fs.promises (Modern Way)
// ==========================================================

const { readFile, writeFile } = require('fs').promises;

const start = async () => {

    try {

        // Read file
        const first = await readFile('./content/first.txt', 'utf8');

        // Write file
        await writeFile(
            './content/result-mind-grenade.txt',
            `This is awesome: ${first}`
        );

        console.log(first);

    }
    catch (error) {

        console.log(error);

    }

};

function normal() {
    console.log("hello");
}

start();
normal();

/*
Expected Output

hello
this is from first txt file

Why?

start()
      │
      ▼
readFile()
      │
Promise Pending
      │
await pauses ONLY start()
      │
Node.js continues
      │
normal()
      │
hello
      │
Promise Resolved
      │
start() resumes
      │
Print file contents

✔ Cleanest approach
✔ Uses async/await
✔ Recommended in modern Node.js
*/


// ==========================================================
// REVISION NOTES
// ==========================================================

/*

CALLBACK
--------
readFile(path, callback)

✔ Async
✔ Callback function

--------------------------------------------

CUSTOM PROMISE
--------------
return new Promise((resolve, reject)=>{})

✔ We manually convert callback into Promise.

--------------------------------------------

UTIL.PROMISIFY
--------------
util.promisify(readFile)

✔ Converts callback API to Promise API.

--------------------------------------------

FS.PROMISES
-----------
const { readFile } = require('fs').promises

✔ Already Promise-based.
✔ No need for util.promisify().

--------------------------------------------

THEN() vs AWAIT

.then()

getPath(...)
   .then(...)
   .catch(...)

await

const data = await getPath(...)

Both work with Promises.

await is just cleaner syntax.

--------------------------------------------

Remember

readFile()           -> Callback
readFilePromise()    -> Promise
fs.promises.readFile -> Promise

await works ONLY with Promises.

await pauses ONLY the async function.

It DOES NOT block the Node.js Event Loop.

*/